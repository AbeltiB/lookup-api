  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.1.2",
    "eslint": "^10.7.0",
    "prisma": "^7.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbeltiB/lookup-api.git"
